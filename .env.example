# Required. Create one at https://hyperserve.io/api-keys
HYPERSERVE_API_KEY=

# Optional. Only needed for the webhook step in the README.
# Shown once when you create a webhook at https://hyperserve.io/webhooks
HYPERSERVE_WEBHOOK_SECRET=

# Optional. Must include the /api suffix.
# HYPERSERVE_API_URL=https://api.hyperserve.io/api
